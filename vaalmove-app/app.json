{
  "expo": {
    "name": "VaalMove",
    "slug": "vaalmove",
    "scheme": "vaalmove",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#3E8FE8",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vaalmove.app"
    },
    "android": {
      "package": "com.vaalmove.app",
      "adaptiveIcon": {
        "backgroundColor": "#3E8FE8"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar"
    ]
  }
}
